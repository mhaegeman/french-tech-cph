# --- GitHub Pages / hosting ---
# Set automatically by the deploy workflow (actions/configure-pages).
# For local dev or a custom domain, leave empty.
BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://frenchtechcopenhagen.com

# --- Luma calendar embed ---
# e.g. https://lu.ma/embed/calendar/<id>/events
NEXT_PUBLIC_LUMA_CALENDAR_URL=

# --- Forms (static-export friendly) ---
# Point at a Formspree / Web3Forms / similar endpoint.
# When unset, the contact page shows a mailto fallback.
NEXT_PUBLIC_CONTACT_FORM_URL=
NEXT_PUBLIC_NEWSLETTER_FORM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=frenchtechcopenhagen@gmail.com

# --- Search engine ownership verification (optional) ---
# Used at build time to emit verification <meta> tags so you can verify the
# site in Google Search Console and Bing Webmaster Tools, then submit the
# sitemap and request indexing. Set these as GitHub Actions repo "Variables"
# (Settings → Secrets and variables → Actions → Variables) for production.
# Google: the "HTML tag" method gives a content="..." string — paste it here.
GOOGLE_SITE_VERIFICATION=
# Bing: the "Add a meta tag" method gives a content="..." string for
# <meta name="msvalidate.01" ...> — paste that value here.
BING_SITE_VERIFICATION=
